  "description": "Design, diagram and share editable Papers with your AI agent.",
  "author": {
    "name": "Gustav Online",
    "url": "https://github.com/gustavonline"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/gustavonline/openpaperdesign",
  "homepage": "https://github.com/gustavonline/openpaperdesign",
  "keywords": [
    "design",
    "diagrams",
    "canvas",
    "mcp",
    "skills"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
